<script>
  declare global {
    interface Window {
      toggleVersion: () => void;
    }
  }

  window.toggleVersion = function () {
    const currentVersion =
      localStorage.getItem("version") === "bioluminescence"
        ? "auto"
        : "bioluminescence";
    localStorage.setItem("version", currentVersion);
    location.reload(); // Reload the page to apply changes
  };

  // On page load, set the correct version
  window.onload = () => {
    const savedVersion = localStorage.getItem("version") || "auto";
    if (savedVersion === "bioluminescence") {
      document.body.classList.add("bioluminescence");
      console.log("Bioluminescence version loaded");
      // Additional logic to dynamically load content if needed
    } else {
      document.body.classList.remove("bioluminescence");
      console.log("Default version loaded");
    }
  };
</script>

<button onclick="toggleVersion()">Switch Version</button>


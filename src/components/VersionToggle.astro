<script>
  declare global {
    interface Window {
      toggleVersion: () => void;
    }
  }

  window.toggleVersion = function () {
    const currentPath = window.location.pathname;
    let newPath;

    // Determine new path based on current path
    if (currentPath.includes("/bioluminescence")) {
      newPath = currentPath.replace("/bioluminescence", "");
      localStorage.setItem("version", "auto");
    } else {
      newPath = "/bioluminescence" + currentPath;
      localStorage.setItem("version", "bioluminescence");
    }

    // Only update URL and reload if there's an actual change
    if (window.location.pathname !== newPath) {
      window.history.pushState({}, "", newPath);
      location.reload(); // Reload to apply changes
    }
  };

  // On page load, set the correct version based on stored preference
  window.onload = () => {
    const savedVersion = localStorage.getItem("version") || "auto";
    let newPath;

    if (
      savedVersion === "bioluminescence" &&
      !window.location.pathname.includes("/bioluminescence")
    ) {
      newPath = "/bioluminescence" + window.location.pathname;
    } else if (
      savedVersion === "auto" &&
      window.location.pathname.includes("/bioluminescence")
    ) {
      newPath = window.location.pathname.replace("/bioluminescence", "");
    }

    // Only update URL and reload if there's an actual change
    if (newPath && window.location.pathname !== newPath) {
      window.history.replaceState({}, "", newPath);
      location.reload(); // Reload to apply changes
    }
  };
</script>

<button onclick="toggleVersion()">Switch Version</button>


<script>
  declare global {
    interface Window {
      toggleVersion: () => void;
    }
  }

  window.toggleVersion = function () {
    const currentVersion =
      localStorage.getItem("version") === "bioluminescence"
        ? "auto"
        : "bioluminescence";
    localStorage.setItem("version", currentVersion);
    const newPath =
      currentVersion === "bioluminescence" ? "/bioluminescence/" : "/";
    window.location.pathname = newPath; // Redirect to the new version

    location.reload(); // Reload the page to apply changes
  };

  // On page load, set the correct version
  window.onload = () => {
    const savedVersion = localStorage.getItem("version") || "auto";
    const newPath =
      savedVersion === "bioluminescence" ? "/bioluminescence/" : "/";

    if (window.location.pathname !== newPath) {
      window.location.pathname = newPath; // Redirect to the correct version
    }
  };
</script>

<button onclick="toggleVersion()">Switch Version</button>

<style>
  button {
    background-color: var(--lightAccent);
    border: none;
    border-radius: 10px;
    color: white;
    padding: 15px 32px;

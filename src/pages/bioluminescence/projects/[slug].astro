---
import { getCollection, getEntry } from "astro:content";
import Site from "../../../../bioluminescence/layouts/Site.astro";
import NextProject from "../../../../bioluminescence/components/NextProject.svelte";
import Footer from "../../../../bioluminescence/components/Footer.astro";

export async function getStaticPaths() {
  const projects = await getCollection("bio_projects");
  return projects.map((post) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;

// use date
const projects = (await getCollection("bio_projects")).sort((a, b) =>
  a.data.date > b.data.date ? -1 : 1
);

const idx = projects.findIndex((p) => p.slug === slug);
if (idx === -1) {
  throw new Error(`Project with slug '${slug}' not found`);
}

const { Content } = await projects[idx].render();

let nextProject;
for (let i = 1; i < projects.length; i++) {
  const nextIdx = (idx + i) % projects.length;
  if (projects[nextIdx].data.alt !== "hidden") {
    nextProject = projects[nextIdx];
    break;
  }
}
---

<Site>
  <div class="glass-bg">
    <Content />
  </div>
  <NextProject
    project={{
      slug: nextProject?.slug,
      ...(nextProject?.data || {}),
    }}
  />
  <Footer />
</Site>
